{
  "name": "site-shot-github-action",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that captures one public HTTPS page as a PNG with the Site-Shot API, through the official site-shot-sdk.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/site-shot/screenshot-action.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc",
    "test": "node --import ./test/support/no-network.ts --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "site-shot-sdk": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
